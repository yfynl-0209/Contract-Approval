# ---- 服务地址 ----
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- mock 审批系统（M2 起使用）----
MOCK_APPROVAL_BASE_URL=http://127.0.0.1:8001
MOCK_APPROVAL_TOKEN=demo-token

# ---- 数据库与存储 ----
# 留空/默认 = SQLite（零配置可跑）。M9 换 PostgreSQL 时改成：
#   DB_URL=postgresql+psycopg://contract:<密码>@127.0.0.1:55432/contract
# 结构由 Alembic 管理（alembic upgrade head）；SQLite 开发库仍用 scripts/init_db.py
DB_URL=sqlite:///./data/app.db
STORAGE_ROOT=./storage

# ---- M9：Redis（可选：留空 = 纯 DB 轮询，行为与 M9 前一致）----
# 只做加速（唤醒/锁/有界缓存）；workflow_jobs 仍是作业的唯一真相来源
# REDIS_URL=redis://127.0.0.1:56379/0
REDIS_URL=

# ---- M9：MinIO（STORAGE_BACKEND=minio 时必填 access/secret）----
# 默认 local（本机 ./storage）；容器拓扑用 minio（endpoint 不带 scheme）
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=127.0.0.1:59000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=contract-objects
MINIO_SECURE=false
PRESIGN_EXPIRES_SECONDS=600

# ---- 审批接入（M3）----
# 去重唯一键 = APPROVAL_PROVIDER + TENANT_ID + instance_id
APPROVAL_PROVIDER=mock
TENANT_ID=default
GATEWAY_TIMEOUT_SECONDS=10
# 拉取作业幂等键的时间窗口（分钟）：同一窗口内重复点击合流为一个作业
PULL_WINDOW_MINUTES=1

# ---- 附件校验（M3）----
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_ALLOWED_TYPES=application/pdf

# ---- 对象存储（M3 用 local；M9 增 minio，端口语义不变）----
STORAGE_BACKEND=local

# ---- LLM 三层降级：三项留空则自动降级为纯规则模式，无需任何 Key ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# 自建/量化端点对 JSON 模式返回 400 时改为 false（schema 校验仍兜底）
LLM_USE_JSON_RESPONSE_FORMAT=true

# ---- harness（回写门禁）----
HIGH_RISK_REQUIRE_MANUAL=true
WRITEBACK_MAX_RETRY=2

# ---- 环境与身份（M7）----
# ENV=production / prod 会触发下面的**启动校验**：AUTH_MODE 必须是 jwt、
# 且必须配置验签公钥与 iss/aud —— 不通过则**进程起不来**，绝不降级为匿名访问。
ENV=development
# dev = 读请求头（X-Actor-Id / X-Actor-Roles / X-Tenant-Id，**仅开发期**）；
# jwt = 校验令牌（生产）。
AUTH_MODE=dev

# ---- JWT（AUTH_MODE=jwt 时必填）----
# 公钥与 JWKS **二选一**，至少一个；都没有时生产环境拒绝启动。
JWT_PUBLIC_KEY=
JWT_JWKS_URL=
JWT_ISSUER=
JWT_AUDIENCE=
# 算法来自**配置**，不取令牌的 alg 头（防算法混淆）
JWT_ALGORITHMS=RS256
# 企业 IdP 的声明名可改（默认 sub / name / roles / tenant_id）
JWT_SUBJECT_CLAIM=sub
JWT_NAME_CLAIM=name
JWT_ROLES_CLAIM=roles
JWT_TENANT_CLAIM=tenant_id
JWT_LEEWAY_SECONDS=0

# ---- MCP 形态（M7 Task 6 / scripts/run_mcp.py）----
# stdio 传输的身份来自**进程环境变量**（客户端在启动配置里给）：
MCP_ACTOR_ID=
MCP_ACTOR_NAME=
MCP_ACTOR_ROLES=
MCP_TENANT_ID=
# AUTH_MODE=jwt 时用：Bearer <令牌>
MCP_AUTHORIZATION=
